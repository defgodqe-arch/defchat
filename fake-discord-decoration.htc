$\",\"li\",\"3\",{\"children\":\"$L29\"}]]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"23:[\"$\",\"$L2a\",null,{\"ref\":\"$undefined\",\"href\":\"/fake-discord-decoration\",\"locale\":\"$undefined\",\"localeCookie\":{\"name\":\"NEXT_LOCALE\",\"sameSite\":\"lax\",\"maxAge\":31536000},\"target\":\"$undefined\",\"className\":\"text-sm text-muted-foreground hover:text-primary transition-colors duration-200\",\"children\":\"discord fake avatar decorations\"}]\n24:[\"$\",\"$L2a\",null,{\"ref\":\"$undefined\",\"href\":\"/how-to-get-free-discord-avatar-decorations\",\"locale\":\"$undefined\",\"localeCookie\":\"$23:props:localeCookie\",\"target\":\"$undefined\",\"className\":\"text-sm text-muted-foreground hover:text-primary transition-colors duration-200\",\"children\":\"how to get free discord avatar decorations\"}]\n26:[\"$\",\"$L2a\",null,{\"ref\":\"$undefined\",\"href\":\"/privacy-policy\",\"locale\":\"$undefined\",\"localeCookie\":\"$23:props:localeCookie\",\"target\":\"$undefined\",\"className\":\"hover:text-primary transition-colors duration-200\",\"children\":\"Privacy Policy\"}]\n27:[\"$\",\"$L2a\",null,{\"ref\":\"$undefined\",\"href\":\"/terms-of-service\",\"locale\":\"$undefined\",\"localeCookie\":\"$23:props:localeCookie\",\"target\":\"$undefined\",\"className\":\"hover:text-primary transition-colors duration-200\",\"children\":\"Terms of Service\"}]\n28:[\"$\",\"$L2a\",null,{\"ref\":\"$undefined\",\"href\":\"/refund-policy\",\"locale\":\"$undefined\",\"localeCookie\":\"$23:props:localeCookie\",\"target\":\"$undefined\",\"className\":\"hover:text-primary transition-colors duration-200\",\"children\":\"Refund Policy\"}]\n29:[\"$\",\"$L2a\",null,{\"ref\":\"$undefined\",\"href\":\"/terms-of-service#acceptable-use\",\"locale\":\"$undefined\",\"localeCookie\":\"$23:props:localeCookie\",\"target\":\"$undefined\",\"className\":\"hover:text-primary transition-colors duration-200\",\"children\":\"Acceptable Use Policy\"}]\n"])</script><script>self.__next_f.push([1,"3:[\"$\",\"$L2b\",null,{\"formats\":\"$undefined\",\"locale\":\"en\",\"messages\":{\"common\":{\"user\":{\"sign_in\":\"Sign In\",\"sign_out\":\"Sign Out\",\"credits\":\"Credits\",\"api_keys\":\"API Keys\",\"my_orders\":\"My Orders\",\"my_account\":\"My Account\",\"user_center\":\"User Center\",\"admin_system\":\"Admin System\"},\"my_account\":{\"title\":\"My Account\",\"member_since\":\"Member Since\",\"subscription\":\"Subscription\",\"no_active_subscription\":\"No Active Subscription\",\"upgrade_plan\":\"Upgrade Plan\",\"manage_subscription\":\"Manage Subscription\",\"current_plan\":\"Current Plan\",\"interval_month\":\"Monthly\",\"interval_year\":\"Annually\",\"expires_at\":\"Expires\",\"credits\":\"Credits\",\"valid_credits\":\"Valid Credits\",\"used_credits\":\"Used Credits\",\"recharge\":\"Recharge\"},\"sign_modal\":{\"sign_in_title\":\"Welcome to AvatarDecoration\",\"sign_in_description\":\"Sign in to your account\",\"sign_up_title\":\"Sign Up\",\"sign_up_description\":\"Create an account\",\"email_title\":\"Email\",\"email_placeholder\":\"Input your email here\",\"password_title\":\"Password\",\"password_placeholder\":\"Input your password here\",\"forgot_password\":\"Forgot password?\",\"or\":\"Or\",\"continue\":\"Continue\",\"no_account\":\"Don't have an account?\",\"email_sign_in\":\"Sign in with Email\",\"google_sign_in\":\"Sign in with Google\",\"github_sign_in\":\"Sign in with GitHub\",\"close_title\":\"Close\",\"cancel_title\":\"Cancel\",\"firstSignInBonus\":\"Bonus credits on first sign-in\",\"dailyFreeCredits\":\"Free models available for everyone, no credit card required\"},\"my_orders\":{\"title\":\"My Orders\",\"description\":\"orders paid with AvatarDecoration.\",\"no_orders\":\"No orders found\",\"tip\":\"\",\"activate_order\":\"Activate Order\",\"actived\":\"Activated\",\"join_discord\":\"Join Discord\",\"read_docs\":\"Read Docs\",\"table\":{\"order_no\":\"Order No\",\"email\":\"Email\",\"product_name\":\"Product Name\",\"amount\":\"Amount\",\"paid_at\":\"Paid At\",\"github_username\":\"GitHub Username\",\"status\":\"Status\",\"manage_billing\":\"Manage Billing\",\"interval\":\"Interval\",\"interval_month\":\"Monthly\",\"interval_year\":\"Annually\",\"interval_one_time\":\"One-Time\"}},\"my_credits\":{\"title\":\"My Credits\",\"left_tip\":\"left credits: {left_credits}\",\"no_credits\":\"No credits records\",\"recharge\":\"Recharge\",\"table\":{\"trans_no\":\"Trans No\",\"trans_type\":\"Trans Type\",\"credits\":\"Credits\",\"updated_at\":\"Updated At\",\"status\":\"Status\",\"expired_at\":\"Expired At\",\"created_at\":\"Created At\"}},\"api_keys\":{\"title\":\"API Keys\",\"tip\":\"Please keep your apikey safe to avoid leaks\",\"no_api_keys\":\"No API Keys\",\"create_api_key\":\"Create API Key\",\"table\":{\"name\":\"Name\",\"key\":\"Key\",\"created_at\":\"Created At\"},\"form\":{\"name\":\"Name\",\"name_placeholder\":\"API Key Name\",\"submit\":\"Submit\"}},\"blog\":{\"title\":\"Blog\",\"description\":\"News, resources, and updates about AvatarDecoration\",\"read_more_text\":\"Read More\"},\"my_invites\":{\"title\":\"My Invites\",\"description\":\"View your invite records\",\"no_invites\":\"No invite records found\",\"my_invite_link\":\"My Invite Link\",\"edit_invite_link\":\"Edit Invite Link\",\"copy_invite_link\":\"Copy Invite Link\",\"invite_code\":\"Invite Code\",\"invite_tip\":\"Invite 1 friend to buy AvatarDecoration, reward $50.\",\"invite_balance\":\"Invite Reward Balance\",\"total_invite_count\":\"Total Invite Count\",\"total_paid_count\":\"Total Paid Count\",\"total_award_amount\":\"Total Award Amount\",\"update_invite_code\":\"Set Invite Code\",\"update_invite_code_tip\":\"Input your custom invite code\",\"update_invite_button\":\"Save\",\"no_orders\":\"You can't invite others before you bought AvatarDecoration\",\"no_affiliates\":\"You're not allowed to invite others, please contact us to apply for permission.\",\"table\":{\"invite_time\":\"Invite Time\",\"invite_user\":\"Invite User\",\"status\":\"Status\",\"reward_percent\":\"Reward Percent\",\"reward_amount\":\"Reward Amount\",\"pending\":\"Pending\",\"completed\":\"Completed\"}},\"feedback\":{\"title\":\"Feedback\",\"description\":\"We'd love to hear what went well or how we can improve the product experience.\",\"submit\":\"Submit\",\"loading\":\"Submitting...\",\"contact_tip\":\"Other ways to contact us\",\"rating_tip\":\"How do you feel about AvatarDecoration?\",\"placeholder\":\"Leave your words here...\"}},\"homePage\":{\"metadata\":{\"title\":\"Hailou AI – All In One AI Image, Video \u0026 Music Generator\",\"description\":\"Hailou AI turns text and images into stunning videos, visuals, and songs in minutes. One creative workspace for all your AI projects.\"},\"hero\":{\"title\":\"Hailou AI – All In One AI Image, Video \u0026 Music Generator\",\"subtitle\":\"Bring your creative vision to life — generate professional images, videos, and music in minutes\",\"buttons\":[{\"title\":\"AI Video Generator\",\"url\":\"#video-generator\",\"icon\":\"RiVideoLine\"}]},\"feature\":{\"title\":\"What You Can Create with Hailou AI\",\"description\":\"From text-to-video and text-to-image to AI music composition, Hailou AI brings all your creative tools into one workspace. Just describe what you need, and watch Hailou AI bring it to life.\",\"badge\":\"Hailou AI Creative Suite\",\"cta\":\"Start creating with Hailou AI now\",\"features\":[{\"id\":1,\"title\":\"Text to Video with Hailou AI\",\"subtitle\":\"Turn Simple Prompts into High-Impact Videos\",\"description\":\"Type a description, and Hailou AI turns it into professional video footage. Whether it's for social media, marketing, or branded storytelling, Hailou AI understands your intent and delivers smooth, dynamic results.\",\"features\":[\"Generate complete videos from a simple text prompt\",\"Control style, mood, pacing, and transitions with Hailou AI\",\"Produce HD videos optimized for social platforms and campaigns\",\"Get multiple video variations in seconds to iterate fast\"],\"icon\":\"RiMovie2Line\",\"imageUrl\":\"/imgs/feature/feature-text-to-video.jpg\"},{\"id\":2,\"title\":\"Image to Video with Hailou AI\",\"subtitle\":\"Animate Any Image with Smart Motion\",\"description\":\"Upload a photo or design, and Hailou AI adds natural camera motion, depth, and transitions to bring it to life. Perfect for turning static visuals into engaging short videos.\",\"features\":[\"Hailou AI analyzes your image and adds smooth, cinematic motion\",\"Customize camera paths, zoom effects, and animation speed\",\"Preserve key subjects while enhancing backgrounds and depth\",\"Extend a single image into longer video sequences with Hailou AI\"],\"icon\":\"RiImageAddLine\",\"imageUrl\":\"/imgs/feature/feature-image-to-video.jpg\"},{\"id\":3,\"title\":\"Text to Image with Hailou AI\",\"subtitle\":\"Create Stunning Visuals from Words\",\"description\":\"Describe what you need, and Hailou AI generates detailed, high-resolution images in seconds. Ideal for marketing visuals, storyboards, thumbnails, and social content — no design skills required.\",\"features\":[\"Generate on-brand images from detailed text prompts\",\"Describe your desired art style, mood, and composition in natural language\",\"Output high-resolution, print-ready visuals for any campaign\",\"Explore unlimited variations to refine your concept with Hailou AI\"],\"icon\":\"RiBrushLine\",\"imageUrl\":\"/imgs/feature/feature-text-to-image.jpg\"},{\"id\":4,\"title\":\"Image to Image with Hailou AI\",\"subtitle\":\"Restyle, Enhance, and Reimagine Any Visual\",\"description\":\"Hand Hailou AI an existing image, and transform it with a simple prompt. Restyle, enhance, or completely reimagine your visuals — no complex editing software needed.\",\"features\":[\"Apply new visual styles with Hailou AI style transfer\",\"Remove, replace, or add elements using natural language prompts\",\"Generate multiple creative alternatives from a single base image\",\"Upscale and sharpen images with Hailou AI resolution enhancement\"],\"icon\":\"RiContrastDropLine\",\"imageUrl\":\"/imgs/feature/feature-image-to-image.jpg\"},{\"id\":5,\"title\":\"Lyrics to Song with Hailou AI\",\"subtitle\":\"Turn Your Words into Fully Arranged Tracks\",\"description\":\"Paste your lyrics, and Hailou AI composes a complete song around them — matching rhythm, emotion, and structure with backing tracks and optional AI vocals.\",\"features\":[\"Hailou AI detects mood, tempo, and phrasing from your lyrics\",\"Choose genres and instruments from the Hailou AI music panel\",\"Add AI vocals that follow your lyrics with natural delivery\",\"Fine-tune arrangement, structure, and mix to your taste\"],\"icon\":\"RiMusic2Line\",\"imageUrl\":\"/imgs/feature/feature-lyrics-to-song.jpg\"},{\"id\":6,\"title\":\"Text to Song with Hailou AI\",\"subtitle\":\"Compose Royalty-Free Music from a Prompt\",\"description\":\"Describe the mood, style, and instruments you want, and Hailou AI generates unique, royalty-free music. Perfect for intros, background tracks, ads, podcasts, and full songs — no licensing headaches.\",\"features\":[\"Create original music from natural language prompts with Hailou AI\",\"Control tempo, length, intensity, and song structure\",\"Export tracks for videos, ads, and commercial projects\",\"All Hailou AI music is royalty-free for worry-free use\"],\"icon\":\"RiPlayListFill\",\"imageUrl\":\"/imgs/feature/feature-text-to-song.jpg\"}]},\"benefits\":{\"title\":\"Why Hailou AI is Different\",\"description\":\"Hailou AI brings text-to-video, text-to-image, image-to-video, and AI music generation together in one platform. With natural language control and production-grade output, Hailou AI makes professional content creation accessible to everyone.\",\"items\":[{\"icon\":\"RiApps2Line\",\"highlight\":\"Cutting-Edge AI Models\",\"title\":\"Access the Best AI Models in One Place\",\"description\":\"Hailou AI goes beyond its own models — you also get access to leading AI engines from Google, OpenAI, Kling, and more. Compare results, pick your favorite, and always create with the most advanced technology available.\"},{\"icon\":\"RiWalletLine\",\"highlight\":\"Simple Pricing\",\"title\":\"One Subscription, Unlimited Creativity\",\"description\":\"No need to juggle multiple AI subscriptions. Hailou AI gives you images, videos, and music generation all under one plan. Pay once, create everything — it's the most cost-effective way to access top AI creative tools.\"},{\"icon\":\"RiChat3Line\",\"highlight\":\"Natural Language First\",\"title\":\"Just Describe What You Want\",\"description\":\"Skip the complex timelines and filters. With Hailou AI, you describe your idea in plain language and get production-ready videos, images, and music back. Hailou AI handles the heavy lifting.\"},{\"icon\":\"RiSparklingLine\",\"highlight\":\"Multimodal Engine\",\"title\":\"Images, Video \u0026 Music — All Connected\",\"description\":\"Hailou AI ties visuals, motion, and sound together so your content feels cohesive. Generate matching videos, images, and soundtracks without juggling disconnected tools.\"},{\"icon\":\"RiTimeLine\",\"highlight\":\"Speed \u0026 Scale\",\"title\":\"Create More in Less Time\",\"description\":\"Hailou AI cuts production time dramatically. Generate multiple variations, test new directions, and build full content packs in minutes — so you can focus on strategy, not repetitive manual work.\"},{\"icon\":\"RiSlidersLine\",\"highlight\":\"Creative Control\",\"title\":\"Fine-Tuned Outputs, Not Random Results\",\"description\":\"Start with a quick prompt, then dial in the details — style, pacing, framing, duration, genre, and more. Hailou AI gives you both speed and granular creative control in the same interface.\"}]},\"use-cases\":{\"title\":\"Who Uses Hailou AI\",\"description\":\"From solo creators to enterprise teams, Hailou AI helps you produce high-quality videos, images, and music at scale. Whatever your workflow, Hailou AI adapts to your creative goals.\",\"items\":[{\"icon\":\"RiUser3Line\",\"title\":\"For You — Photos, Videos \u0026 Music Made Easy\",\"description\":\"Enhance your selfies, turn travel photos into cinematic videos, or create a song just for fun. Hailou AI makes powerful AI tools accessible to anyone — no skills needed, just your imagination.\"},{\"icon\":\"RiSparklingLine\",\"title\":\"AI Enthusiasts \u0026 First-Time Explorers\",\"description\":\"Curious about what AI can do? Hailou AI is the perfect place to start. Try text-to-image, image-to-video, and AI music generation all in one place — and see what's possible with just a few words.\"},{\"icon\":\"RiTiktokLine\",\"title\":\"Content Creators \u0026 Influencers\",\"description\":\"YouTubers, TikTokers, and Instagram creators use Hailou AI to produce scroll-stopping videos, thumbnails, and background music. Create weeks of content in minutes — all royalty-free with Hailou AI.\"},{\"icon\":\"RiMegaphoneLine\",\"title\":\"Marketing \u0026 Advertising\",\"description\":\"Marketing teams use Hailou AI to craft ad creatives, social campaigns, product videos, and branded music in one place. Test more variations and stay on-brand with Hailou AI's unified creative suite.\"},{\"icon\":\"RiShoppingBag3Line\",\"title\":\"E‑Commerce \u0026 Product Marketing\",\"description\":\"Online sellers use Hailou AI to create product showcase videos, lifestyle imagery, and catchy jingles for ads. Produce scroll-stopping listings and promo content that drives conversions — no expensive shoots required.\"},{\"icon\":\"RiGraduationCapLine\",\"title\":\"Education \u0026 E‑Learning\",\"description\":\"Educators and course creators rely on Hailou AI to build explainer videos, illustrative visuals, and background music that boosts learner engagement. Turn complex topics into clear, visual stories.\"}]},\"faq\":{\"title\":\"Frequently Asked Questions about Hailou AI\",\"items\":[{\"title\":\"What is Hailou AI?\",\"description\":\"Hailou AI is an all-in-one creative platform that combines AI video generation, image creation, and music composition in a single workspace. With Hailou AI, you can turn simple text prompts into professional videos, visuals, and soundtracks — no advanced technical skills or expensive software needed.\"},{\"title\":\"Do I need design or editing experience to use Hailou AI?\",\"description\":\"Not at all. Hailou AI is built for everyone — from complete beginners to experienced creators. Just describe what you want in plain language, and Hailou AI takes care of the video editing, image rendering, and music composition for you.\"},{\"title\":\"Can I control the style and mood of my content?\",\"description\":\"Absolutely. Hailou AI lets you customize style, mood, pacing, and genre across images, videos, and music. Choose cinematic, playful, minimalist, or branded looks, set your preferred music tempo, and fine-tune outputs with quick adjustments.\"},{\"title\":\"How fast does Hailou AI generate content?\",\"description\":\"Speed depends on complexity, but most images appear in seconds, music tracks in under a minute, and short videos in just a few minutes. Hailou AI is built to be dramatically faster than traditional production workflows.\"},{\"title\":\"Can I use Hailou AI content for commercial projects?\",\"description\":\"Yes. Hailou AI is designed for real-world use. Depending on your plan, you can use Hailou AI outputs for social media, marketing campaigns, client work, and more. See the Hailou AI terms for full details on commercial usage and rights.\"},{\"title\":\"Is my data safe on Hailou AI?\",\"description\":\"Hailou AI uses secure infrastructure and encryption to protect your projects, prompts, and account data. Your content stays private and is never used to train models without your explicit consent. We take security and privacy seriously so you can create with confidence.\"}]},\"cta\":{\"title\":\"Start Creating with Hailou AI Today\",\"description\":\"Turn your ideas into videos, images, and music in minutes. No complex tools, no steep learning curve — just describe what you want, and let Hailou AI bring it to life.\",\"buttons\":[{\"title\":\"Get Started\",\"url\":\"#video-generator\",\"target\":\"_self\"}]}},\"pricingPage\":{\"modal_title\":\"Upgrade Your Plan\",\"pricing\":{\"name\":\"pricing\",\"label\":\"Pricing\",\"title\":\"Pricing\",\"description\":\"Start free, upgrade when you need more. No subscriptions, no recurring charges.\",\"groups\":[],\"items\":[{\"title\":\"Free\",\"description\":\"Try the basic decoration tool at no cost\",\"features_title\":\"Includes\",\"features\":[\"Free Discord avatar decoration tool\",\"Unlimited basic decorations\",\"Download and use anywhere\",\"No account required\"],\"interval\":\"one-time\",\"amount\":0,\"cn_amount\":0,\"currency\":\"USD\",\"price\":\"$$0\",\"unit\":\"\",\"is_featured\":false,\"button\":{\"title\":\"Start for Free\",\"url\":\"/#decoration\",\"icon\":\"RiArrowRightLine\"},\"product_id\":\"free\",\"product_name\":\"Free\",\"credits\":0,\"valid_months\":0},{\"title\":\"AvatarDecoration Standard\",\"description\":\"Ideal for content creators and AI Generated Power enthusiasts\",\"label\":\"Popular\",\"features_title\":\"Includes\",\"features\":[\"300 credits, valid for 1 months\",\"Priority generation queue\",\"24/7 customer support\",\"Watermark-free downloads\",\"Commercial use rights\"],\"interval\":\"one-time\",\"amount\":2999,\"cn_amount\":0,\"currency\":\"USD\",\"price\":\"$$29.99\",\"price_label\":\"Save 30%\",\"unit\":\"USD\",\"is_featured\":true,\"button\":{\"title\":\"Get Standard\",\"url\":\"/#pricing\",\"icon\":\"RiFlashlightFill\"},\"product_id\":\"standard\",\"product_name\":\"AvatarDecoration Standard\",\"credits\":300,\"valid_months\":1},{\"title\":\"AvatarDecoration Basic\",\"description\":\"Perfect for hobbyists exploring AI avatar creation\",\"features_title\":\"Includes\",\"features\":[\"70 credits, valid for 1 month\",\"Standard generation speed\",\"24/7 customer support\",\"Watermark-free downloads\",\"Commercial use rights\"],\"interval\":\"one-time\",\"amount\":999,\"cn_amount\":0,\"currency\":\"USD\",\"price\":\"$$9.99\",\"unit\":\"USD\",\"is_featured\":false,\"button\":{\"title\":\"Get Basic\",\"url\":\"/#pricing\",\"icon\":\"RiFlashlightFill\"},\"product_id\":\"basic\",\"product_name\":\"AvatarDecoration Basic\",\"credits\":70,\"valid_months\":1}]},\"modal\":{\"title\":\"Upgrade Your Plan\"},\"faq\":{\"name\":\"faq\",\"title\":\"FAQ\",\"description\":\"Frequently Asked Questions\",\"items\":[{\"title\":\"Will I be charged repeatedly?\",\"description\":\"No. All our plans are one-time payments — there are no subscriptions or recurring charges. You only pay once for the credits you need, and you can purchase again whenever you're ready.\"},{\"title\":\"Will I be charged if image generation fails?\",\"description\":\"No. If a generation fails, no credits are deducted from your account. As long as your content complies with our usage policy, you can simply try again. If the issue persists, please contact us with the error time and we'll be happy to help.\"},{\"title\":\"How do credits work?\",\"description\":\"Credits are used each time you use AI to generate images  Each plan comes with a specific amount of credits that are valid for the specified duration. Once credits expire or are used up, you'll need to purchase a new plan.\"},{\"title\":\"How do I choose the right AvatarDecoration pricing plan?\",\"description\":\"Consider your creation volume and quality requirements when selecting a AvatarDecoration plan. Choose Basic if you're just getting started with AI generation. Standard works well for regular content creators needing more credits with longer validity. The Premium plan is ideal for professionals and businesses requiring maximum credits for commercial projects.\"},{\"title\":\"Do unused AvatarDecoration credits carry forward?\",\"description\":\"No, unused credits do not carry forward. Each plan has a specific validity period, and credits expire at the end of that period. We recommend choosing a plan that matches your expected usage within the validity timeframe.\"},{\"title\":\"Is there a refund policy?\",\"description\":\"We offer a 72-hour refund policy for unused credits. Please refer to our \u003ca href='/refund-policy'\u003erefund policy\u003c/a\u003e for more details.\"},{\"title\":\"What happens if I run out of credits?\",\"description\":\"When you run out of credits, you can purchase a new plan that best fits your needs. Since we offer one-time payment plans, you have the flexibility to choose different plans based on your current requirements without being locked into a subscription.\"}]}},\"privacyPolicyPage\":{\"metadata\":{\"title\":\"Privacy Policy - {brandName}\",\"description\":\"Learn how {brandName} protects your personal information. Our comprehensive privacy policy covers data collection, usage, storage, and your rights as a user of our AI platform.\"},\"title\":\"Privacy Policy\",\"lastUpdated\":\"Last Updated: {effectiveDate}\",\"introduction\":{\"heading\":\"Introduction\",\"text\":\"Welcome to {brandName} (\\\"we,\\\" \\\"our,\\\" or \\\"us\\\"). This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you visit our website {webUrl} and use our AI-powered content generation services.\"},\"informationWeCollect\":{\"heading\":\"Information We Collect\",\"personalInfo\":{\"heading\":\"Personal Information\",\"items\":{\"account\":\"Account Information: Name, email address, username, and password\",\"payment\":\"Payment Information: Billing details and subscription information (processed securely through third-party payment processors)\",\"profile\":\"Profile Information: Any additional information you choose to provide\"}},\"usageInfo\":{\"heading\":\"Usage Information\",\"items\":{\"content\":\"Content Data: Images and other content you create or upload\",\"analytics\":\"Usage Analytics: How you interact with our services, features used, and performance data\",\"device\":\"Device Information: IP address, browser type, operating system, and device identifiers\"}},\"autoCollected\":{\"heading\":\"Automatically Collected Information\",\"items\":{\"cookies\":\"Cookies and similar tracking technologies\",\"logs\":\"Log files and server data\",\"session\":\"Session information and preferences\"}}},\"howWeUse\":{\"heading\":\"How We Use Your Information\",\"text\":\"We use your information to:\",\"items\":{\"provide\":\"Provide and maintain our AI content generation services\",\"process\":\"Process your subscription and handle billing\",\"improve\":\"Improve our AI models and service quality\",\"updates\":\"Send important updates and notifications\",\"support\":\"Provide customer support\",\"security\":\"Ensure platform security and prevent fraud\",\"legal\":\"Comply with legal obligations\"}},\"aiContent\":{\"heading\":\"AI Content and Data Processing\",\"items\":{\"generation\":\"Content Generation: Your prompts and generated content may be used to improve our AI models\",\"retention\":\"Data Retention: Generated content is stored according to your account settings and our retention policies\",\"training\":\"Model Training: Anonymized and aggregated data may be used to enhance our AI capabilities\"}},\"informationSharing\":{\"heading\":\"Information Sharing\",\"text\":\"We do not sell your personal information. We may share information with:\",\"items\":{\"providers\":\"Service Providers: Third-party vendors who assist in operating our platform\",\"payment\":\"Payment Processors: For subscription and billing purposes\",\"legal\":\"Legal Requirements: When required by law or to protect our rights\",\"business\":\"Business Transfers: In case of merger, acquisition, or sale of assets\"}},\"dataSecurity\":{\"heading\":\"Data Security\",\"text\":\"We implement industry-standard security measures including:\",\"items\":{\"encryption\":\"Encryption of data in transit and at rest\",\"audits\":\"Regular security audits and monitoring\",\"access\":\"Access controls and authentication protocols\",\"payment\":\"Secure payment processing\"}},\"yourRights\":{\"heading\":\"Your Rights\",\"text\":\"You have the right to:\",\"items\":{\"access\":\"Access and review your personal information\",\"update\":\"Update or correct your account information\",\"delete\":\"Delete your account and associated data\",\"export\":\"Export your generated content\",\"optOut\":\"Opt-out of non-essential communications\",\"portability\":\"Request data portability\"}},\"cookies\":{\"heading\":\"Cookies and Tracking\",\"text\":\"We use cookies and similar technologies to:\",\"items\":{\"session\":\"Maintain your login session\",\"preferences\":\"Remember your preferences\",\"analytics\":\"Analyze platform usage\",\"experience\":\"Improve user experience\"},\"manage\":\"You can manage cookie preferences through your browser settings.\"},\"dataRetention\":{\"heading\":\"Data Retention\",\"items\":{\"account\":\"Account Data: Retained while your account is active\",\"content\":\"Generated Content: Stored according to your subscription plan\",\"usage\":\"Usage Data: Retained for analytics and service improvement\",\"deleted\":\"Deleted Accounts: Data permanently deleted within 30 days\"}},\"internationalTransfers\":{\"heading\":\"International Data Transfers\",\"text\":\"Your information may be transferred to and processed in countries other than your own. We ensure appropriate safeguards are in place for such transfers.\"},\"childrensPrivacy\":{\"heading\":\"Children's Privacy\",\"text\":\"Our services are not intended for users under 13 years of age. We do not knowingly collect personal information from children under 13.\"},\"thirdParty\":{\"heading\":\"Third-Party Services\",\"text\":\"Our platform may integrate with third-party services. This Privacy Policy does not cover the practices of such third parties. Please review their privacy policies separately.\"},\"changes\":{\"heading\":\"Changes to This Policy\",\"text\":\"We may update this Privacy Policy periodically. We will notify you of significant changes via email or platform notification.\"},\"contact\":{\"heading\":\"Contact Us\",\"text\":\"For questions about this Privacy Policy or our data practices, contact us at:\",\"emailLabel\":\"Email: {email}\"},\"footer\":\"This Privacy Policy is effective as of the last updated date and applies to all users of {brandName} services.\"},\"refundPolicyPage\":{\"metadata\":{\"title\":\"Refund Policy - {brandName}\",\"description\":\"Understand {brandName}'s refund policy including eligibility requirements, credit usage terms, application process, and our 72-hour refund window for unused credits.\"},\"title\":\"Refund Policy\",\"intro\":\"Your satisfaction is our top priority at {brandName}. We've established a transparent refund process to ensure your peace of mind when trying our services. Before proceeding with your purchase, please take a moment to review our refund terms.\",\"qualification\":{\"heading\":\"Qualification Requirements\",\"requestWindow\":{\"heading\":\"Request Window\",\"text\":\"To be eligible for a refund, submit your request within 72 hours (3 days) of completing your purchase. We're unable to accommodate requests after this timeframe.\"},\"creditUsage\":{\"heading\":\"Credit Usage Policy\",\"text\":\"Refunds are calculated based on unused credits only. Any credits that have been consumed or utilized will be deducted from the refund amount. Only the remaining unused credits are eligible for reimbursement at their original purchase value.\"}},\"process\":{\"heading\":\"Refund Application Process\",\"text\":\"Eligible customers can initiate a refund by following these straightforward steps:\",\"steps\":{\"contact\":\"Initiate Contact: Send your request to our customer care team via {email}\",\"info\":\"Essential Information: Your request should contain your user credentials, login email, order ID, payment timestamp, and reason for seeking a refund\",\"submit\":\"Timely Submission: Remember to submit your application within the 72-hour eligibility window\"}},\"review\":{\"heading\":\"Review and Reimbursement\",\"text\":\"Our team will promptly evaluate your refund application and communicate the decision. Successful requests will result in reimbursement through your original payment channel.\"},\"updates\":{\"heading\":\"Policy Updates\",\"text\":\"These terms may be modified as our services evolve. We maintain the latest version on this page and recommend checking back occasionally for any updates.\"},\"assistance\":{\"heading\":\"Need Assistance?\",\"text\":\"For any clarification about our money-back guarantee or other inquiries, our support team is ready to help at {email}.\"}},\"termsOfServicePage\":{\"metadata\":{\"title\":\"Terms of Service - {brandName}\",\"description\":\"Read {brandName}'s terms of service covering user responsibilities, acceptable use policies, subscription terms, and legal agreements for our AI-powered content generation platform.\"},\"title\":\"Terms of Service\",\"lastUpdated\":\"Last Updated: {effectiveDate}\",\"acceptance\":{\"heading\":\"Acceptance of Terms\",\"text\":\"By accessing or using {brandName} (\\\"Service\\\"), you agree to be bound by these Terms of Service (\\\"Terms\\\"). If you do not agree to these Terms, do not use our Service.\"},\"description\":{\"heading\":\"Description of Service\",\"text\":\"{brandName} is an AI-powered platform that enables users to generate images, videos, music, 3D models, and voices. Our Service is provided on a subscription basis with various pricing tiers.\"},\"account\":{\"heading\":\"Account Registration\",\"eligibility\":{\"heading\":\"Eligibility\",\"items\":{\"age\":\"You must be at least 13 years old to use our Service\",\"accurate\":\"You must provide accurate and complete information\",\"security\":\"You are responsible for maintaining account security\"}},\"responsibilities\":